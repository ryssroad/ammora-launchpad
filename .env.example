# Optional. Defaults to the reviewed public GIWA template Config #6 so the
# site can launch before you create your own. Set this to the Config ID
# printed by `npm run create-config` after that transaction confirms.
# Read on the server at runtime (no rebuild required on Vercel).
CONFIG_ID=6

# Optional public mirror. The server prefers CONFIG_ID.
NEXT_PUBLIC_CONFIG_ID=6

# create-config only. A throwaway GIWA Sepolia key. Never set this on Vercel
# and never prefix it with NEXT_PUBLIC_.
AMMORA_PRIVATE_KEY=

# Keyless preview of create-config. Ignored when AMMORA_PRIVATE_KEY is set.
# AMMORA_ACCOUNT=0xYourPublicAddress

# Preview is the default. Set to 1 only after you have reviewed the printed hash.
AMMORA_SEND=0
AMMORA_REVIEW_HASH=

# Optional economics, as raw integers (not human amounts).
# Defaults match the launchpad guide's example: 1,000 tokens at 9 decimals
# and a 0.000001 WETH graduation threshold at 18 decimals.
# SALE_SUPPLY_RAW=1000000000000
# QUOTE_THRESHOLD_RAW=1000000000000
# AMMORA_TEMPLATE_ID=6
# AMMORA_MAX_FEE_PER_GAS=150000000

# Optional RPC override. Defaults to the SDK catalog endpoint.
# AMMORA_RPC_URL=https://sepolia-rpc.giwa.io
